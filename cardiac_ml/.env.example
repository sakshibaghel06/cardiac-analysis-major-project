#######################################################################
# CardioCare - ML / payments API environment
#######################################################################
#
# These are SERVER-SIDE values. Unlike the frontend's VITE_ variables,
# nothing here is ever sent to the browser, so real secrets belong in
# this file - and this file must never be committed.
#
# The API does NOT read a .env file automatically (there is no
# python-dotenv dependency). Export the variables into the shell that
# starts uvicorn. See README.md -> "Configuring the payment API".
#
#   Windows PowerShell:   $env:RAZORPAY_KEY_ID = "rzp_test_..."
#   Windows cmd:          set RAZORPAY_KEY_ID=rzp_test_...
#   Git Bash / macOS:     export RAZORPAY_KEY_ID=rzp_test_...
#
# Copy this file to cardiac_ml/.env and keep it as your own reference
# of which values you have set. .env is git-ignored.
#
#######################################################################


# ---------------------------------------------------------------------
# CORS - which frontend origins may call this API
# ---------------------------------------------------------------------
# Comma-separated. Optional: the default already covers the Vite dev
# server on 5173/5174 over http and https. Set it when you deploy the
# frontend somewhere else, or the browser will block every call.
#
# CARDIAC_ALLOWED_ORIGINS=http://localhost:5173,https://cardiocare.example.com


# ---------------------------------------------------------------------
# Razorpay - required ONLY for the payment step
# ---------------------------------------------------------------------
# Everything else (risk prediction, consultations, video, prescriptions)
# runs fine with these unset. With them unset, GET /payments/config
# honestly reports {"configured": false} and the UI says payment is
# unavailable rather than pretending a payment succeeded.
#
# Where to get them:
#   https://dashboard.razorpay.com -> Account & Settings -> API Keys
#   -> Generate Test Key. You get a key id and a secret; the secret is
#   shown ONCE.
#
# Use rzp_test_... keys in development. Test keys move no real money.
# Live keys (rzp_live_...) require a Razorpay account that has
# completed KYC - see README.md before assuming payments can be demoed.
#
# RAZORPAY_KEY_ID is public (the browser receives it from
# /payments/create-order). RAZORPAY_KEY_SECRET signs and verifies
# payments and must never leave the server.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set when you create a webhook in the Razorpay dashboard
# (Settings -> Webhooks). It is a value YOU choose there, not one
# Razorpay issues. The server verifies the webhook signature against
# the RAW request body using this secret - a different secret from
# the checkout one above.
RAZORPAY_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
# Firebase Admin SDK - required to RECORD a payment
# ---------------------------------------------------------------------
# The payment endpoints write to Firestore with admin credentials.
# This is deliberate: because only the server can write /payments and
# consultation paymentStatus, firestore.rules forbids every client
# write to those paths, so a browser can never mark itself paid.
#
# Needs BOTH:
#   1. pip install firebase-admin   (it is in requirements.txt)
#   2. a service-account JSON key, pointed at by the variable below
#
# Get the key:
#   Firebase Console -> Project settings -> Service accounts
#   -> Generate new private key
#
# THIS FILE IS A REAL CREDENTIAL. It bypasses all security rules.
# Store it OUTSIDE the repository. The root .gitignore blocks the
# usual filenames, but do not rely on that - keep it out of the tree.
#
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\you\secrets\cardiac-adminsdk.json
