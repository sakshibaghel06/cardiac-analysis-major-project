# =====================================================
# CardioCare - Frontend environment configuration
# Copy this file to .env and fill in the values.
# .env is git-ignored. Never commit real values.
# =====================================================

# -----------------------------------------------------
# Firebase (web config)
# -----------------------------------------------------
# NOTE: Firebase web config values are not secrets - they are
# shipped to the browser by design. Your data is protected by
# Firestore security rules, NOT by hiding these values.
# They live here so that different environments (dev / prod)
# can point at different Firebase projects.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------
# ML prediction API  (VITE_ML_API_URL)
# -----------------------------------------------------
VITE_ML_API_URL=http://127.0.0.1:8001

# -----------------------------------------------------
# WebRTC TURN relay (optional but strongly recommended)
# -----------------------------------------------------
# STUN alone only works when both peers can reach each other
# directly. On college / corporate / mobile networks that is
# usually blocked, and the call will silently fail to connect.
# A TURN server relays the media and fixes this.
# Leave blank to run STUN-only (fine for same-machine testing).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# -----------------------------------------------------
# Consultation fee (rupees)
# -----------------------------------------------------
# Used when a doctor record has no `fee` field of its own.
# None of the existing doctor documents have one, so without
# this the payment step can never be reached.
VITE_DEFAULT_CONSULTATION_FEE=500

# -----------------------------------------------------
# Demo payment
# -----------------------------------------------------
# Demo payments are simulated in the browser and use the existing
# signed-in Firebase client; no payment gateway configuration is needed.
