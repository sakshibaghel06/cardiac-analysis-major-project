# React / Vite
cardiac/node_modules/
cardiac/dist/
cardiac/.vite/

# Environment variables
cardiac/.env
cardiac/.env.local
cardiac/.env.development
cardiac/.env.production

# Python virtual environment
cardiac_ml/venv/
cardiac_ml/.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python environment files
.env
.env.*

# ...but DO track the example templates (no real secrets in them)
!.env.example
!**/.env.example

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Build / cache
.cache/

# Firebase emulator artefacts
*-debug.log
firebase-debug.*.log
.firebase/

# Rules test harness
tests/node_modules/
tests/package-lock.json

# Generated test artefacts (regenerated by the test scripts).
# test_prescription_pdf.mjs writes these relative to the cwd it is run
# from, so they can land under either scripts/ directory.
**/sample-prescription.pdf
**/sample-prescription-long.pdf

# Service-account / admin credentials - NEVER commit these
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
*.pem
*.p12
*.key
!cardiac_mobile/**/*.key

# Local scratch files
/support.pdf

# Flutter build output (belt and braces - cardiac_mobile/.gitignore
# also covers these, but a copy here survives that file being moved)
cardiac_mobile/build/
cardiac_mobile/.dart_tool/
cardiac_mobile/firebase.local.json

# Seeding config (environment-specific UIDs)
scripts/seed.config.json
